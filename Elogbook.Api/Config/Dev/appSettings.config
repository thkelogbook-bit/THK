<?xml version="1.0"?>
<appSettings>
	<!--Key cấu hình domain-->
	<add key="DOMAIN" value="https://nkvh.vn:8090/thk/" />
	<!--Key cấu hình các thuộc tính để tạo file log4net, mục đích để monitor lỗi trong quá trình sử dụng ứng dụng-->
	<add key="LOG4NET_CONFIG_FILE" value="Config\Dev\log4net.config" />
	<!--Key cấu hình thời gian expire token của người dùng, thời gian tính bằng phút, mặc định 8 giờ-->
	<add key="DEFAULT_TOKEN_EXPIRE_MINUTES" value="480" />
	<!--Key cấu hình thông tin server để lấy thông tin người dùng AD-->
	<add key="AD_LDAP" value="" />
	<!--Tài khoản người dùng tạo kết nối đến AD server-->
	<add key="AD_USERNAME" value="" />
	<!--Mật khẩu của người dùng-->
	<add key="AD_PASSWORD" value="" />
	<!--Cấu hình thư mục lưu trữ files trên IIS server-->
	<add key="FILE_STORAGE_SERVER_DIR" value="C:\wwwRoot\Elogbook\Attachments\" />
	<!--Cấu hình thư mục lưu trữ files Lucene trên IIS server-->
	<add key="FILE_LUCENE_SERVER_DIR" value="C:\wwwRoot\Elogbook\Attachments\LuceneIndex" />
	<!--Đường dẫn truy cập files từ client để server-->
	<add key="SERVER_DIR" value="https://nkvh.vn:8090/Attachments/" />
	<!--Các thông tin CERT, KEY, APIID của Viettel hỗ trợ cho việc ký số trên ứng dụng-->
	<add key="VIETTEL_CERT" value="" />
	<add key="VIETTEL_KEY" value="" />
	<add key="VIETTEL_APIID" value="AP2" />
	<add key="VIETTEL_CA_DOTNET_WEB_MobileCAWS_APWsImplService" value="http://171.244.149.211:8080/apws.asmx" />
	<add key="VNPT_SP_ID" value="44ef-639151306398625141.apps.smartcaapi.com" />
	<add key="VNPT_SP_PASSWORD" value="YTc5YzQwNWI-MDZlOS00MmMx" />
	<add key="VNPT_GATEWAY_URL" value="https://gwsca.vnpt.vn/sca/sp769/v1" />
	<add key="VNPT_MAX_POLLING_COUNT" value="30" />
	<add key="VNPT_POLLING_INTERVAL_MS" value="10000" />
	<!--Cấu hình chuyển đổi mật khẩu từ hệ thống cũ (true thì cho phép api hoạt động, việc chạy api này chỉ thực hiện lúc migration data)-->
	<add key="ALLOW_MIGRATE_PASSWORD" value="true" />
	<!--Thời gian server trả dữ liệu cho mobile app để sử dụng offline, mặc định sẽ là 7 ngày. Hạn chế tăng thời gian quá lớn vì ảnh hướng đến việc lưu trữ dữ liệu trên thiết bị-->
	<add key="DATE_SYNC_DATA_MOBILE" value="7" />
	<!--Cấu hình chỉ hiển thị Ca làm việc theo giờ thực tế hay hiển thị tất cả các Ca. False thì hiển thị tất cả, true thì chỉ hiển thị ca theo giờ thực tế-->
	<add key="ALLOW_GET_SHIFT_BY_CURRENT_TIME" value="false" />
	<!--Thời gian timeout khi kết nối đến cơ sở dữ liệu-->
	<add key="EFCommandTimeout" value="180" />
	<!--Thời gian trigger đồng bộ dữ liệu offline khi thiết bị có internet, giá trị tính bằng phút-->
	<add key="SYNC_OFFLINE_TIME" value="5" />
	<!--Định nghĩa thời gian xóa dữ liệu offline ở thiết bị, giá trị tính bằng ngày-->
	<add key="DELETE_OFFLINE" value="7" />
	<add key="VALIDATION_KEY" value="UlZaT0xUSXdMVEV5TFRJd01qWXRSV3h2WjJKdmIycz0=" />
	<add key="NKVH_ISEXTENDTIME" value="true" />
	<!--Định nghĩa thời gian xóa file log, mặc định sẽ xóa file của 7 ngày trước-->
	<add key="LAST_TIME_DELETE_LOG" value="-7" />
	<!--Cho phép disable log khi chạy quartz-->
	<add key="IS_TURN_OFF_LOG_QUARTZ" value="false" />
	<!--Schedule chạy đồng bộ dữ liệu sang PMIS-->
	<add key="CRON_SCHEDULE_PMIS" value="0 0/30 * * * ?" />
	<!--Schedule chạy đồng bộ dữ liệu PMIS sang Elogbook-->
	<add key="CRON_SCHEDULE_PMIS_ELOGBOOK" value="0 42 20 * * ?" />
	<!--Định nghĩa thời gian lấy dữ liệu thay đổi để đồng bộ sang PMIS, mặc định lấy những thông số cập nhật trong khoảng 2 giờ trước đó-->
	<add key="TIME_GET_LATEST_DATA_PMIS" value="-2" />
	<!--Schedule reset số PCT không dử dụng-->
	<add key="CRON_SCHEDULE_TICKET_NUMBER" value="0 0 1 * * ?" />
	<!--Schedule xóa file log-->
	<add key="CRON_SCHEDULE_DELETE_LOG" value="0 0 2 * * ?" />
	<!---Schedule gửi mail-->
	<add key="CRON_SCHEDULE_SEND_MAIL" value="0 0/01 * * * ?"/>
	<!--Schedule tạo work ticket-->
	<add key="CRON_SCHEDULE_WORK_TICKET" value="0 0/1 * 1/1 * ? *"/>
	<!--Schedule backup data-->
	<add key="CRON_SCHEDULE_BACKUP_DATA" value="0 0/1 * 1/1 * ? *"/>
	<!--Schedule tạo autonomous maintenance-->
	<add key="CRON_SCHEDULE_AUTONOMOUS_MAINTENANCE" value="0 15 0 1/1 * ? *"/>
	<!--Thư mục chứa dữ liệu Elogbook đọc và cập nhật vào hệ thống-->
	<add key="EXCEL_DESTINATION_FOLDER_PATH" value="C:\FTP\DATA_DCS\Data MOPER_1\Archive" />
	<!--Thư mục chứa file excel dữ liệu tự động export từ hệ thống DCS-->
	<add key="EXCEL_ROOT_FOLDER_PATH" value="C:\FTP\DATA_DCS\Data MOPER_1\Export" />
	<!--TÊN FILE EXCEL THÔNG SỐ ĐỘ RUNG - ĐỘ ĐẢO-->
	<add key="EXCEL_FILENAME_RUNG_DAO" value="THONG SO RUNG DAO TO MAY COPY EXCEL" />
	<!--TÊN FILE EXCEL THÔNG SỐ VẬN HÀNH TỔ MÁY H1-->
	<add key="EXCEL_FILENAME_TMH1" value="THONG SO GIAN MAY TAI METSO TO MAY H1 COPY EXCEL" />
	<!--TÊN FILE EXCEL THÔNG SỐ VẬN HÀNH TỔ MÁY H2-->
	<add key="EXCEL_FILENAME_TMH2" value="THONG SO GIAN MAY TAI METSO TO MAY H2 COPY EXCEL" />
	<!--TÊN FILE EXCEL THÔNG SỐ VẬN HÀNH THIẾT BỊ ĐIỆN TRUNG TÂM-->
	<add key="EXCEL_FILENAME_TRUNG_TAM" value="THONG SO VAN HANH THIET BI DIEN TRUNG TAM COPY EXCEL" />
	<!--Số ngày cần đọc dữ liệu DCS so với ngày hiện tại trở về trước-->
	<add key="DCS_DAY_READ_DATA" value="3" />
	<!--Show thông tin Tình hình lúc nhận ca cho nhật ký vận hành hay không-->
	<add key="IS_SHOW_SHIFT_RECEIVING" value="false" />
	<!--Show thông báo hay không-->
	<add key="IS_SHOW_NOTIFICATION" value="false" />
	<!--Khi flag này true, thì với cương vị Trưởng ca sẽ luôn yêu cầu có một Trưởng kíp, ngược lại thì theo logic chung của ứng dụng-->
	<add key="IS_REQUIRED_TEAMLEADER_IN_SHIFTLEADER" value="false" />
	<!--Cấu hình đồng bộ dữ liệu thông số sang table để lấy thông tin cảnh báo-->
	<add key="CRON_SCHEDULE_SYNC_DATA_OPERATION_PARAMETER_WARNING" value="0 0/1 * 1/1 * ? *"/>
	<!--Định nghĩa thời gian xóa dữ liệu xuất báo cáo nhật ký vận hành, mặc định xóa dữ liệu của 30 ngày trước-->
	<add key="LAST_TIME_DELETE_REPORT_NKVH" value="-30" />
	<!--Cấu hình thời gian chạy job để tạo phiếu đăng ký công việc từ file excel-->
	<add key="CRON_SCHEDULE_REGIST_WORK_TICKET" value="0 0/1 * 1/1 * ? *"/>
	<!--Phân công ca: khoảng thời gian tối đa cho phép mỗi lần tạo bảng phân công, giá trị tính bằng ngày, mặc định 31 ngày-->
	<add key="ASSIGNMENT_MAX_CREATE_DAYS" value="7" />
	<!--Phân công ca: thời gian cho phép được cập nhật nhân sự trong một slot, tính bằng giờ trước giờ bắt đầu ca, mặc định 24 giờ-->
	<add key="ASSIGNMENT_UPDATE_DEADLINE_HOURS" value="24" />
	<!--Google Gemini API Key dùng cho tính năng KnowledgeBaseAi (tra cứu tài liệu bằng AI)-->
	<add key="GEMINI_API_KEY" value="" />
	<!--Google Gemini model name. Xem danh sách tại: https://ai.google.dev/gemini-api/docs/models-->
	<add key="GEMINI_MODEL" value="gemini-3.6-flash" />
	<!--HistoryCall job: cron archive TSVH cũ hơn 12 tháng sang OperationParametersHistoryCall. Mặc định: Thứ 7 và Chủ nhật 2:00 AM-->
	<add key="CRON_SCHEDULE_HISTORY_CALL" value="0 0 2 ? * SAT,SUN" />
	<!--HistoryCall job: số bản ghi tối đa mỗi batch (mặc định 50000)-->
	<add key="HISTORY_CALL_BATCH_SIZE" value="50000" />
	<!--HistoryCall job: số batch tối đa trong một lần chạy job (mặc định 10)-->
	<add key="HISTORY_CALL_MAX_BATCHES" value="10" />
	<!--Các mốc thời gian để thông báo phiếu công tác sắp đến thời gian theo kế hoạch nhưng chưa kết thúc-->
	<add key="WORK_TICKET_BEFORE_COMPLETION_NOTIFICATION_HOURS" value="12" />
	<!--Các mốc thời gian để thông báo phiếu công tác đã quá thời gian theo kế hoạch nhưng chưa kết thúc-->
	<add key="WORK_TICKET_AFTER_COMPLETION_NOTIFICATION_HOURS" value="24|48" />
	<!--Định nghĩa khoảng thời gian quanh mốc cần lấy danh sách phiếu để gửi thông báo-->
	<add key="WORK_PERMIT_NOTIFICATION_WINDOW_MINUTES" value="5" />
	<!--Cấu hình thời gian chạy job để gửi thông báo nhắc nhở, cảnh báo phiếu công tác chưa hoàn thành theo kế hoạch-->
	<add key="CRON_SCHEDULE_WORK_TICKET_COMPLETION_NOTIFICATION_HOURS" value="0 0/1 * 1/1 * ? *"/>
	<!--Các mốc thời gian để thông báo Phiếu công tác có nhân viên chưa rời khỏi vị trí làm việc-->
	<add key="WORK_TICKET_NOTSIGNEDOUT_NOTIFICATION_HOURS" value="12|60|72" />
	<!--Cấu hình thời gian chạy job để gửi thông báo nhắc nhở, cảnh báo Phiếu công tác có nhân viên chưa rời khỏi vị trí làm việc-->
	<add key="CRON_SCHEDULE_WORK_TICKET_NOTSIGNEDOUT_NOTIFICATION_HOURS" value="0 0/1 * 1/1 * ? *"/>
	<!--Open Notebook Integration: Base URL của Open Notebook FastAPI backend (port 5055). Ví dụ: http://192.168.1.100:5055-->
	<add key="OPEN_NOTEBOOK_BASE_URL" value="http://51.79.164.255:5055" />
	<!--Open Notebook Integration: Mật khẩu xác thực (APP_PASSWORD phía Open Notebook). Để trống nếu không cần password.-->
	<add key="OPEN_NOTEBOOK_PASSWORD" value="cwT539vojfCEzAlpVePKPFPR" />
	<!--Open Notebook Integration: Timeout (giây) cho mỗi request upload. Mặc định 300 giây (5 phút).-->
	<add key="OPEN_NOTEBOOK_UPLOAD_TIMEOUT_SECONDS" value="300" />
	<!--Open Notebook Integration: Model ID mặc định (dạng "model:xxx") — lấy từ GET /api/models trên Open Notebook UI.
	     Để trống = service tự động lấy language model đầu tiên từ /api/models.-->
	<add key="OPEN_NOTEBOOK_DEFAULT_MODEL" value="" />
	<!--Open Notebook Integration: Timeout (giây) cho request ask (LangGraph workflow). Mặc định 120 giây.-->
	<add key="OPEN_NOTEBOOK_ASK_TIMEOUT_SECONDS" value="600" />
	<!--Viettel MySign (ký số bất đồng bộ qua app MySign): Base URL API-->
	<add key="VIETTEL_MYSIGN_BASE_URL" value="https://remotesigning.viettel.vn" />
	<!--Viettel MySign: Client ID ứng dụng đã đăng ký với Viettel-->
	<add key="VIETTEL_MYSIGN_CLIENT_ID" value="Elogbook_0317759999" />
	<!--Viettel MySign: Client Secret ứng dụng đã đăng ký với Viettel-->
	<add key="VIETTEL_MYSIGN_CLIENT_SECRET" value="aa07e9db25d1395243b9d68e5bd27a51dc0ba64f" />
	<!--Viettel MySign: Profile ID người ký-->
	<add key="VIETTEL_MYSIGN_PROFILE_ID" value="adss:ras:profile:001" />
	<!--Viettel MySign: Số lần polling tối đa chờ người dùng xác nhận trên app (mặc định 30 lần = 150 giây)-->
	<add key="VIETTEL_MYSIGN_MAX_POLLING_COUNT" value="30" />
	<!--Viettel MySign: Thời gian chờ giữa mỗi lần polling (milliseconds, mặc định 5000 = 5 giây)-->
	<add key="VIETTEL_MYSIGN_POLLING_INTERVAL_MS" value="5000" />
