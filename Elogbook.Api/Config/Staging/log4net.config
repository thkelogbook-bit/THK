<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<log4net>
		<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
			<file value="C:\Website\elogbook\api\Logs\thk" />
			<appendToFile value="true" />
			<rollingStyle value="Composite" />
			<datePattern value="_MMddyyyy.'log'" />
			<staticLogFileName value="false" />
			<maxSizeRollBackups value="50" />
			<maximumFileSize value="10MB" />
			<param name="PreserveLogFileNameExtension" value="true" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date{HH:mm:ss} %level %logger- %message%newline%newline" />
			</layout>
		</appender>
		<root>
			<level value="ALL" />
			<!--other below value, log types will wrote
      FATAL : log -> FATAL
      ERROR : log -> FATAL ERROR
      WARN  : log -> FATAL ERROR WARN
      INFO  : log -> FATAL ERROR WARN INFO
      DEBUG (or ALL) : log -> FATAL ERROR WARN INFO DEBUG-->
			<appender-ref ref="RollingFileAppender" />
		</root>
	</log4net>
</configuration>